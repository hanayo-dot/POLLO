# ==============================================================================
# POLLO - Environment Configuration Template
# Planetary Intelligence & Earth System Trend Detection Platform
# ==============================================================================

# Backend Configuration
PORT=8080
ENV=development
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NASA Earthdata & Service Integration (Optional for demonstration mode)
# Register at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_BEARER_TOKEN=

# NASA GIBS (Global Imagery Browse Services) endpoint
NASA_GIBS_ENDPOINT=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best

# Cache & Storage
CACHE_DIR=./data/cache
ENABLE_LOCAL_BENCHMARK=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=POLLO
NEXT_PUBLIC_DEMO_REGION=lake_victoria_basin
